   "file": "cells/coffee_composition_pick.json",
   "hidecode": true,
   "id": "coffee_composition_pick",
   "kind": "code",
   "output": true,
   "source": "@bind coffee_measure Select([\"Caffine\" => \"caffeine\", \"Trigonelline\" => \"trigonelline\",\n                             \"Chlorogenic Acid\" => \"chlorogenic acid\", \"Fat\" => \"fat\",\n                             \"Extract Yield\" => \"extract yield\", \"ph Value\" => \"pH\", \"Water\" => \"water\",\n                             \"Bean Weight\" => \"bean weight\", \"Mineral Content\" => \"mineral content\",\n                             \"Free Acid\" => \"free acid\"], \"Caffine\"; label = \"measure\")",
   "tags": []
  },
  {
   "file": "cells/coffee_composition.json",
   "hidecode": false,
   "id": "coffee_composition",
   "kind": "code",
   "output": true,
   "source": "# The chosen measure for each sample, arabica against robusta.\nlet df = load_dataset(\"coffee_composition\")\n    kinds = unique(df.Variety)\n    pts(k, c) = [[x, i - 1 + 0.3 * (((j * 0.618034) % 1) - 0.5)] for (i, v) in enumerate(kinds)\n                 for (j, x) in enumerate(df[df.Variety .== v, c]) if v == k]\n    echart(;\n        grid = (left = 16, right = 24, top = 32, bottom = 44, containLabel = true),\n        legend = (data = String.(kinds), top = 0),\n        xAxis = valaxis(\"value\"),\n        yAxis = [cataxis(\"\", String.(kinds); boundaryGap = true, axisLine = (show = false,)),\n                 (type = :value, min = -0.5, max = length(kinds) - 0.5, show = false)],\n        tooltip = (trigger = :item, formatter = \"{a}: {@[0]}\"),\n        series = [(type = :scatter, name = String(k), yAxisIndex = 1, symbolSize = 10, itemStyle = (opacity = 0.8,),\n                   data = @replay(coffee_measure, pts(k, coffee_measure.value))) for k in kinds],\n        height = 220,\n        modes(m -> (color = CATEGORICAL[m][1:2],))...,\n    )\nend",
   "tags": [
    "macrocall"
   ]
  },
  {
   "file": "cells/coffee_production.json",

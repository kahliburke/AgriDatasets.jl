  {
   "file": "cells/avocado_us_sale_pick.json",
   "hidecode": true,
   "id": "avocado_us_sale_pick",
   "kind": "code",
   "output": true,
   "source": "@bind avocado_kind Radio([\"Conventional\", \"Organic\"], \"Conventional\"; label = \"avocados\")",
   "tags": []
  },
  {
   "file": "cells/avocado_us_sale.json",
   "hidecode": false,
   "id": "avocado_us_sale",
   "kind": "code",
   "output": true,
   "source": "# Weekly price and units sold for the chosen kind, on two stacked panels that share the time axis.\nlet df = sort(load_dataset(\"avocado_us_sale\"), :week_ending)\n    ms(d) = 1000 * Dates.datetime2unix(DateTime(d))     # a time axis takes milliseconds since 1970\n    pts(k, c, scale) = (r = df[df.type .== k, :];\n                        [[ms(d), round(v / scale; sigdigits = 4)] for (d, v) in zip(r.week_ending, r[!, c])])\n    echart(;\n        grid = [(left = 64, right = 24, top = 16, height = 150), (left = 64, right = 24, top = 206, height = 110)],\n        xAxis = [(type = :time, gridIndex = 0, axisLabel = (show = false,)), (type = :time, gridIndex = 1)],\n        yAxis = [(valaxis(\"price (US\\$)\")..., gridIndex = 0, nameGap = 44),\n                 (valaxis(\"units sold (millions)\")..., gridIndex = 1, nameGap = 44)],\n        axisPointer = (link = [(xAxisIndex = :all,)],),\n        tooltip = (trigger = :axis,),\n        series = [(type = :line, name = \"price\", showSymbol = false, lineStyle = (width = 1.5,),\n                   data = @replay(avocado_kind, pts(avocado_kind, :avg_selling_price, 1))),\n                  (type = :line, name = \"units sold\", xAxisIndex = 1, yAxisIndex = 1, showSymbol = false,\n                   lineStyle = (width = 1.5,), areaStyle = (opacity = 0.15,),\n                   data = @replay(avocado_kind, pts(avocado_kind, :total_bulk_and_bags_units, 1e6)))],\n        height = 360,\n        modes(m -> (color = fill(CATEGORICAL[m][1], 2),))...,\n    )\nend",
   "tags": [
    "macrocall"
   ]
  },

 "cells": [
  {
   "file": "cells/intro.json",
   "id": "intro",
   "kind": "markdown",
   "markdown": "# Dataset gallery\n\nOne chart for each dataset in AgriDatasets, each cell named after the dataset it draws. The dataset\npages of the documentation show them.",
   "native": true,
   "output": true,
   "tags": []
  },
  {
   "file": "cells/setup.json",
   "hidecode": false,
   "id": "setup",
   "kind": "code",
   "output": true,
   "source": "using AgriDatasets, DataFrames, Statistics, Dates, AgriViz\n\n# A proportion column: `k` of `n`.\nshare(df, k, n) = transform(df, [k, n] => ByRow((a, b) -> b > 0 ? a / b : missing) => :proportion)",
   "tags": [
    "import_scaffold"
   ]
  },
  {
   "file": "cells/alfalfa_soil.json",
   "hidecode": false,
   "id": "alfalfa_soil",
   "kind": "code",
   "output": true,
   "source": "echart(; suitability(load_dataset(\"alfalfa_soil\"))...)",
   "tags": []
  },
  {
   "file": "cells/apple_canker.json",
   "hidecode": false,
   "id": "apple_canker",
   "kind": "code",
   "output": true,
   "source": "let df = share(load_dataset(\"apple_canker\"), :y, :n)\n    echart(; curve(combine(groupby(df, [:gen, :inoculum]), :proportion => mean => :proportion),\n                   :inoculum, :proportion; group = :gen)...)\nend",
   "tags": []
  },

   "file": "cells/red_wine_quality_pick.json",
   "hidecode": true,
   "id": "red_wine_quality_pick",
   "kind": "code",
   "output": true,
   "source": "@bind wine_measure Select([\"alcohol\", \"volatile_acidity\", \"sulphates\", \"citric_acid\", \"fixed_acidity\",\n                           \"residual_sugar\", \"chlorides\", \"free_sulfur_dioxide\", \"total_sulfur_dioxide\",\n                           \"density\", \"pH\"] .=> [\"alcohol\", \"volatile acidity\", \"sulphates\", \"citric acid\",\n                           \"fixed acidity\", \"residual sugar\", \"chlorides\", \"free SO₂\", \"total SO₂\", \"density\", \"pH\"],\n                          \"alcohol\"; label = \"measure\")",
   "tags": []
  },
  {
   "file": "cells/red_wine_quality.json",
   "hidecode": false,
   "id": "red_wine_quality",
   "kind": "code",
   "output": true,
   "source": "# Every wine's value of the chosen measure against its quality score, with the mean at each score.\nlet df = load_dataset(\"red_wine_quality\")\n    qs = sort(unique(df.quality))\n    jit(j) = 0.3 * (((j * 0.618034) % 1) - 0.5)\n    pts(c) = [[q - first(qs) + jit(j), x] for (j, (q, x)) in enumerate(zip(df.quality, df[!, c]))]\n    means(c) = [[i - 1, round(mean(df[df.quality .== q, c]); sigdigits = 4)] for (i, q) in enumerate(qs)]\n    echart(;\n        grid = (left = 16, right = 24, top = 16, bottom = 44, containLabel = true),\n        xAxis = [cataxis(\"quality score\", string.(qs); boundaryGap = true, axisLine = (show = false,)),\n                 (type = :value, min = -0.5, max = length(qs) - 0.5, show = false)],\n        yAxis = valaxis(\"value\"),\n        tooltip = (trigger = :item, formatter = \"{@[1]}\"),\n        series = [(type = :scatter, name = \"wines\", xAxisIndex = 1, symbolSize = 5, itemStyle = (opacity = 0.35,),\n                   large = true, data = @replay(wine_measure, pts(wine_measure.value))),\n                  (type = :scatter, name = \"mean\", xAxisIndex = 1, symbol = :rect, symbolSize = [24, 3], z = 4,\n                   data = @replay(wine_measure, means(wine_measure.value)))],\n        height = 340,\n        modes(m -> (series = [(itemStyle = (color = CATEGORICAL[m][1],),), (itemStyle = (color = INK[m].primary,),)],))...,\n    )\nend",
   "tags": [
    "macrocall"
   ]
  },
  {
   "file": "cells/rice_wheat_production_pick.json",
   "hidecode": true,
   "id": "rice_wheat_production_pick",

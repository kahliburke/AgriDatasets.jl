 "cells": [
  {
   "file": "cells/intro.json",
   "id": "intro",
   "kind": "markdown",
   "markdown": "# Dataset tables\n\nFor every dataset in AgriDatasets, a summary of its columns and the data itself. The dataset pages of\nthe documentation show them.",
   "native": true,
   "output": true,
   "tags": []
  },
  {
   "file": "cells/setup.json",
   "hidecode": false,
   "id": "setup",
   "kind": "code",
   "output": true,
   "source": "using AgriDatasets, DataFrames, AgriViz\n\n# The column summary as a table: one row per column. The share missing is drawn as a bar against\n# 0–100%, so a column missing a few values shows a short bar, not a full one.\ncolumns_table(name) = slate_table(column_summary(load_dataset(name)); align = (summary = :left,),\n                                  format = (missing = :percent,), viz = (missing = (kind = :bar, domain = (0, 1)),))\n\n# The first rows of a dataset; the page says how many there are in all.\nconst PREVIEW = 25\npreview(name) = first(load_dataset(name), PREVIEW)",
   "tags": [
    "import_scaffold"
   ]
  },
